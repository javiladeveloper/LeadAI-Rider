<?xml version="1.0" encoding="utf-8"?>
<!--
  Ícono de Jala: las tres flechas del logo, apuntando adelante.

  NO es un vehículo a propósito. Hoy son motos, pero el plan incluye autos —
  una moto dibujada acá dejaría la marca vieja el día que entre el primer
  auto. Las flechas dicen "movimiento" sin decir de qué.

  Las flechas van BLANCAS: este drawable también se usa como ícono monocromo
  (Android 13+ lo tiñe con el wallpaper), y ahí el color se descarta. Con
  blanco sobre el amarillo de fondo se lee igual en las dos variantes.

  Todo dentro de la safe zone del ícono adaptativo (el círculo central de
  66dp en el lienzo de 108): fuera de ahí cada launcher recorta distinto.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Flecha 1 (la de atrás) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M30,32 L46,32 L64,54 L46,76 L30,76 L48,54 Z" />

    <!-- Flecha 2 (centro) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M46,32 L62,32 L80,54 L62,76 L46,76 L64,54 Z" />

    <!-- Flecha 3 (la de adelante) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M62,32 L78,32 L96,54 L78,76 L62,76 L80,54 Z" />
</vector>
