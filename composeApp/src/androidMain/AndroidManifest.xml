<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Ubicación del rider: alimenta el despacho por cercanía ("A X km de
         ti"), el odómetro de km reales y el mapa público /track/:pedidoId que
         ve el cliente. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- ACCESS_BACKGROUND_LOCATION: QUITADO a proposito (2026-08-28).

         Estaba declarado pero el codigo NUNCA lo pedia: `AbrirAjustes` existe
         y no lo llama nadie, asi que Android jamas lo concedia. Un permiso
         muerto que igual disparaba la revision manual mas estricta de Play
         —video demostrativo y justificacion, con rechazo frecuente—.

         No hace falta para lo que la app hace hoy: mientras hay carrera,
         ServicioCarreraActiva llama a startForeground con su notificacion
         ANTES de reportar (y si eso falla, se corta). Con notificacion visible
         Android lo cuenta como primer plano, asi que el rastreo sigue
         funcionando con la app minimizada y la pantalla apagada.

         Lo unico que no cubre es la app CERRADA del todo. Si algun dia se
         quiere eso —Jonathan lo pidio para mas adelante— hay que: pedir el
         permiso desde el codigo (dialogo aparte, "Permitir todo el tiempo",
         que desde Android 11 obliga a pasar por Configuracion), volver a
         declararlo aca, y grabar el video que Google exige. -->
    <!-- El foreground service que mantiene vivo ese reporte mientras dura la
         carrera. FOREGROUND_SERVICE_LOCATION es obligatorio desde Android 14
         para el tipo "location". -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Xiaomi/Oppo y compañía matan la app "para ahorrar batería" en plena
         carrera; con esto el rider puede eximirla desde Configuración. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".LeadAIRiderApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Light Drive"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!--
          VERTICAL fijo: el rider lleva el teléfono en el manubrio y al doblar
          la app giraba sola. Además, rotar destruye y recrea la Activity —
          justo mientras maneja y con el mapa a medio cargar.

          `configChanges` cubre lo que igual puede cambiar (teclado, tamaño de
          ventana, tema): sin esto Android recrearía la pantalla y el mapa
          volvería a cargar desde cero.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Recibe tokens FCM y el push "nueva carrera en tu zona". -->
        <service
            android:name=".push.LeadAIFirebaseService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Reporta el GPS mientras hay carrera, aunque el teléfono esté
             bloqueado. foregroundServiceType="location" NO es opcional:
             sin él Android 14+ mata el service apenas arranca. -->
        <service
            android:name=".ui.carreras.ServicioCarreraActiva"
            android:exported="false"
            android:foregroundServiceType="location" />
    
        <!-- La clave de Google Maps. Sale de MAPS_API_KEY en local.properties
             (o de la variable de entorno en el CI): nunca se commitea.
             Sin clave el mapa se ve gris y en el log aparece
             "Authorization failure". -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />
</application>

</manifest>
