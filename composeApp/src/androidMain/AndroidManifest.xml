<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Ubicación del rider: alimenta el despacho por cercanía ("A X km de
         ti"), el odómetro de km reales y el mapa público /track/:pedidoId que
         ve el cliente. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Ubicación con la app en segundo plano: el rider maneja con el celular
         en el bolsillo o la pantalla bloqueada. Sin esto, al bloquear el
         teléfono el cliente ve la moto CONGELADA en el mapa. Desde Android 11
         este permiso no se puede pedir por diálogo — hay que mandar al
         usuario a Configuración (ver ui/permisos/). -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- El foreground service que mantiene vivo ese reporte mientras dura la
         carrera. FOREGROUND_SERVICE_LOCATION es obligatorio desde Android 14
         para el tipo "location". -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Xiaomi/Oppo y compañía matan la app "para ahorrar batería" en plena
         carrera; con esto el rider puede eximirla desde Configuración. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".LeadAIRiderApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Jala"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Recibe tokens FCM y el push "nueva carrera en tu zona". -->
        <service
            android:name=".push.LeadAIFirebaseService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Reporta el GPS mientras hay carrera, aunque el teléfono esté
             bloqueado. foregroundServiceType="location" NO es opcional:
             sin él Android 14+ mata el service apenas arranca. -->
        <service
            android:name=".ui.carreras.ServicioCarreraActiva"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>

</manifest>
